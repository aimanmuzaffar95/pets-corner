# API
NODE_ENV=development
API_PORT=3000
PORT=3000
JWT_ACCESS_TOKEN_SECRET=replace_with_strong_random_secret
JWT_ACCESS_TOKEN_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=pets_corner_dev
POSTGRES_USER=pets_corner
POSTGRES_PASSWORD=pets_corner_dev_password
DATABASE_URL=postgresql://pets_corner:pets_corner_dev_password@db:5432/pets_corner_dev

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@petscorner.dev
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050
